<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">

            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= projectDetails.title %>" required minlength="3"
                    maxlength="200" />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required
                    maxlength="1000"><%= projectDetails.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= projectDetails.location %>" required
                    maxlength="200" />
            </div>

            <div class="form-group">
                <label for="date">Project Date</label>
                <input type="date" id="date" name="date" value="<%= projectDetails.date %>" required />
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <option value="">Select an organization</option>

                    <% organizations.forEach(organization=> { %>
                        <option value="<%= organization.organization_id %>"
                            <%=organization.organization_id===projectDetails.organization_id ? 'selected' : '' %>
                            >
                            <%= organization.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <button type="submit">Update Project</button>
        </form>

        <p>
            <a href="/project/<%= projectDetails.project_id %>">
                Cancel
            </a>
        </p>
    </main>

    <%- include('partials/footer') %>