        <p>Discover organizations working to make a difference in communities.</p>
    </section>

    <section class="organization-section">

        <div class="organization-card">
            <img src="/images/brightfuture-logo.png" alt="BrightFuture Builders logo">
            <h2>BrightFuture Builders</h2>
            <p>
                Supporting community development and helping create brighter
                futures through service and volunteer opportunities.
            </p>
            <p>Email: info@brightfuture.org</p>
        </div>

        <div class="organization-card">
            <img src="/images/greenharvest-logo.png" alt="GreenHarvest Growers logo">
            <h2>GreenHarvest Growers</h2>
